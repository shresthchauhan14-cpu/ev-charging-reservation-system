# Application Environment Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# If DATABASE_URL is left empty or unreachable, the system automatically uses embedded PostgreSQL 16 (PGlite)
DATABASE_URL=
DATABASE_DIR=./database/pgdata

# Authentication & Security
JWT_SECRET=iilm_ev_charging_system_jwt_secret_dev_2026_key!
JWT_EXPIRES_IN=7d
COOKIE_SECRET=iilm_ev_cookie_signing_secret_dev_2026!

# CORS & Client
CLIENT_ORIGIN=http://localhost:5173

# Business Rules
NO_SHOW_GRACE_PERIOD_MINS=15
MAX_WAITING_TIME_MINS=60

# Waiting List Priority Weights (must sum to 1.0)
WEIGHT_URGENCY=0.50
WEIGHT_WAITING_TIME=0.30
WEIGHT_RELIABILITY=0.20

