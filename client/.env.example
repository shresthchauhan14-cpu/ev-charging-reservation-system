# Client Environment Configuration
# Deployed Backend API Base URL (leave empty in local dev to use Vite proxy /api/v1)
VITE_API_URL=https://api.yourdomain.com/api/v1

# Supabase Cloud Configuration (Optional - provides direct cloud database, Auth & Realtime)
# Found in your Supabase Dashboard: Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-public-key-placeholder

# Enable Quick Viva Demo Role Switcher in Production (defaults to false in production, true in DEV)
VITE_ENABLE_DEMO_SHORTCUTS=false
